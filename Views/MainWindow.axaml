<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FirstLab1App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="FirstLab1App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Лаба 1. Винник Маргарита Дмитриевна, группа 351"
        Width="400" Height="350"
        Background="#BDEEFA"
        Foreground="Blue">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainViewModel />
    </Design.DataContext>

    <!-- <TextBox Text="{Binding Greeting}"
             HorizontalAlignment="Center"
             VerticalAlignment="Center" /> -->
    <StackPanel>
        <Button>
            <TextBlock Text="Красный"/>
        </Button>
        <Button>
            <TextBlock Text="Зелёный"/>
        </Button>
        <Button>
            <TextBlock Text="Синий"/>
        </Button>    
        <Button>
            <TextBlock Text="Жёлтый"/>
        </Button>
        
    </StackPanel>

</Window>
