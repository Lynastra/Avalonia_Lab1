<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FirstLab1App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="FirstLab1App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Лаба 1. Винник Маргарита Дмитриевна, группа 351"
        Width="400" Height="350"
        Background="#BDEEFA"
        Foreground="Blue">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <StackPanel Spacing="5" Margin="15">
        <Button x:Name="BtnRed" Content="Красный" />
        <Button x:Name="BtnGreen" Content="Зелёный" />
        <Button x:Name="BtnBlue" Content="Синий" />
        <Button x:Name="BtnYellow" Content="Жёлтый" />
    </StackPanel>
</Window>
